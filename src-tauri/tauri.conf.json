{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Downly",
	"mainBinaryName": "Downly",
	"version": "0.2.0",
	"identifier": "com.downly",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Downly",
				"width": 960,
				"height": 680,
				"minWidth": 800,
				"minHeight": 560,
				"decorations": false,
				"shadow": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"resources": {
			"resources/": "resources/"
		},
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}
