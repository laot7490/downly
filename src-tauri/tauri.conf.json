{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Downly",
	"mainBinaryName": "Downly",
	"version": "0.8.1",
	"identifier": "com.downly",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Downly",
				"width": 960,
				"height": 680,
				"center": true,
				"minWidth": 960,
				"minHeight": 680,
				"decorations": false,
				"shadow": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$LOCALDATA/Downly/thumbnails/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Emir Genç",
		"createUpdaterArtifacts": true,
		"targets": ["nsis"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3ODc2QkVEMUM3ODFFMTMKUldRVEhuZ2M3V3VIZDN2MkN2cHg3RDFDRmRmK0U2d2J2R25qa0w0bWZPaVdobUF1M2o5MkdBSmwK",
			"endpoints": ["https://github.com/laot7490/downly/releases/latest/download/latest.json"]
		}
	}
}
